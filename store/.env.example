# Copy to store/.env (gitignored); scripts/dev/shop.sh setup does it for you on a fresh checkout.
# Sourced by scripts/dev/shop.sh, run_intake.py and server/app.py. A value already set in the shell wins.
# Never commit store/.env. Never paste a key into a skill, a doc, or a chat.

# ---- required ---------------------------------------------------------------

# dapi public API: origin only, no /v1. One key per department, scoped (PRICING for intake).
DAPI_API_URL=
DAPI_API_KEY=

# Etsy Open API v3 (https://www.etsy.com/developers/your-apps). Research and publish.
# The app must list http://localhost:3003/oauth/redirect as a callback; shop.sh setup
# then signs in once and writes store/etsy_token.json.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# fal.ai (fal.ai/dashboard/keys): the design stage's lifestyle photos and clip. Spends money per call.
FAL_KEY=   # FAL_API_KEY also accepted

# ---- Claude: how workers (claude -p) sign in; pick one or neither ----------

# Neither: workers use whatever `claude auth login` signed this machine in to.
# A subscription token from `claude setup-token`, for machines without a browser login:
#CLAUDE_CODE_OAUTH_TOKEN=
# An API key: workers bill to the API in dollars.
#ANTHROPIC_API_KEY=
# auto | api | subscription; subscription hides ANTHROPIC_API_KEY from workers.
#DAPILOT_BILLING=auto

# ---- social posting (when a platform is enabled in store/config.json) -------

# Instagram: a long-lived token from the Meta app dashboard, or the app's id and secret for the sign-in flow.
#INSTAGRAM_ACCESS_TOKEN=
#INSTAGRAM_APP_ID=
#INSTAGRAM_APP_SECRET=
# Browser adapters for X, TikTok, LinkedIn, kept outside the plugin.
#DAPILOT_SOCIAL_ADAPTER_DIR=

# ---- optional ---------------------------------------------------------------

# Only when the dapi account has more than one store.
#DAPI_STORE_ID=
# Store-private files: Etsy token, reference/ (pricing policy, fees, taxonomy), products, social sessions.
DAPILOT_STORE_DIR=./store
# Interpreter with requirements.txt installed; shop.sh setup creates ./.venv.
DAPILOT_PYTHON=./.venv/bin/python
# Found on their own at the default macOS paths.
#BLENDER=/Applications/Blender.app/Contents/MacOS/Blender
#CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# The studio page the design stage captures from (npm run dev in frontend/).
#DAPILOT_STUDIO_URL=http://localhost:8081
