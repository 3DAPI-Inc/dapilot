# Copy to store/.env (gitignored). Sourced by scripts/dev/test_phase0.sh and run_intake.py.
# Never commit store/.env. Never paste a key into a skill, a doc, or a chat.

# Optional. When set, worker runs bill to the API in dollars. Leave empty or
# comment out to use the logged-in Claude subscription instead. Per run you can
# also force it: run_intake.py --billing subscription | api, or DAPILOT_BILLING=.
#ANTHROPIC_API_KEY=

# dapi public API: origin only, no /v1. One key per department, scoped.
DAPI_API_URL=
DAPI_API_KEY=

# Interpreter with trimesh, scipy, networkx, jsonschema.
DAPILOT_PYTHON=./.venv/bin/python

# Blender binary for render-model (default: /Applications/Blender.app/Contents/MacOS/Blender)
BLENDER=

# Where store-private files live: the Etsy OAuth token, reference/platform-fees.json,
# reference/etsy_buyer_taxonomy.json. Scripts that need it fail loudly when unset.
DAPILOT_STORE_DIR=./store

# Etsy Open API v3 (https://www.etsy.com/developers/your-apps). Key-only calls
# (search, public listings) need both; shop and inventory calls also need the
# OAuth token that scripts/etsy_auth.py login writes to store/etsy_token.json.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# fal.ai, for Wan video generation (generate_video.py). Get one at fal.ai/dashboard/keys.
# Spends money per call; every run is a real generation.
FAL_API_KEY=   # FAL_KEY also accepted
