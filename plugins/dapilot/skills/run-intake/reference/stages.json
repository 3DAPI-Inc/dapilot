{
  "process": "intake",
  "comment": "Fixed order. A stage runs when every `requires` glob matches in the work dir and no `produces` glob does. Disabled stages are listed so the vocabulary is agreed before they exist.",
  "stages": [
    {"stage": "analyze", "skill": "analyze-model", "requires": ["source.*"], "produces": ["analysis.json"], "gate": "auto", "enabled": true},
    {"stage": "quote",   "skill": "quote-model",   "requires": ["source.*", "analysis.json"], "produces": ["quote.json"], "gate": "auto", "enabled": false},
    {"stage": "render",  "skill": "render-model",  "requires": ["source.*", "analysis.json"], "produces": ["renders/hero.png"], "gate": "auto", "enabled": false},
    {"stage": "copy",    "skill": "write-listing", "requires": ["analysis.json", "quote.json", "renders/hero.png"], "produces": ["listing.json"], "gate": "auto", "enabled": false},
    {"stage": "publish", "skill": "publish-listing", "requires": ["listing.json"], "produces": ["publish.json"], "gate": "propose", "enabled": false}
  ]
}
