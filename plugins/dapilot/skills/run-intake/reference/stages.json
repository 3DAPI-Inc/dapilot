{
  "process": "intake",
  "comment": "Fixed order. A stage runs when every `requires` glob matches in the work dir and no `produces` glob does. Reordered 2026-09-09: cheap drafts, research and the price proposal come before the expensive media, so an item that cannot sell never costs a capture or a generation. 2026-09-13: `design` (product-designer) replaces `render`; the storefront is Etsy, so copy and publish stay disabled until they are rebuilt for it. 2026-09-17: design also requires `price.approved.json`, written when a person confirms or overrides the proposed price in the console (POST /jobs/{id}/price); nothing paid runs for a price nobody approved. A stage's `agent` overrides the department worker. Disabled stages are listed so the vocabulary is agreed before they exist.",
  "stages": [
    {
      "stage": "analyze",
      "skill": "analyze-model",
      "requires": [
        "source.*"
      ],
      "produces": [
        "analysis.json"
      ],
      "gate": "auto",
      "enabled": true
    },
    {
      "stage": "quote",
      "skill": "quote-model",
      "requires": [
        "source.*",
        "analysis.json"
      ],
      "produces": [
        "quote.json"
      ],
      "gate": "auto",
      "enabled": true
    },
    {
      "stage": "preview",
      "skill": "preview-model",
      "requires": [
        "source.*",
        "analysis.json"
      ],
      "produces": [
        "renders/draft_00.png"
      ],
      "gate": "auto",
      "enabled": true
    },
    {
      "stage": "research",
      "skill": "research-comparables",
      "requires": [
        "meta.json",
        "analysis.json",
        "quote.json",
        "renders/draft_00.png"
      ],
      "produces": [
        "comparables.json",
        "viability.json"
      ],
      "gate": "auto",
      "enabled": true
    },
    {
      "stage": "price",
      "skill": "propose-price",
      "requires": [
        "quote.json",
        "comparables.json",
        "viability.json",
        "renders/draft_00.png"
      ],
      "produces": [
        "price.json"
      ],
      "gate": "auto",
      "enabled": true
    },
    {
      "stage": "design",
      "skill": "design-product",
      "agent": "product-designer",
      "requires": [
        "source.*",
        "analysis.json",
        "renders/draft_00.png",
        "price.json",
        "price.approved.json",
        "comparables.json"
      ],
      "produces": [
        "design.json"
      ],
      "gate": "auto",
      "enabled": true
    },
    {
      "stage": "copy",
      "skill": "write-listing",
      "requires": [
        "analysis.json",
        "quote.json",
        "comparables.json",
        "price.json",
        "design.json"
      ],
      "produces": [
        "listing.json"
      ],
      "gate": "auto",
      "enabled": false
    },
    {
      "stage": "publish",
      "skill": "publish-listing",
      "requires": [
        "listing.json"
      ],
      "produces": [
        "publish.json"
      ],
      "gate": "propose",
      "enabled": false
    }
  ]
}
