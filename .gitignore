# Render output. Frames and videos are regenerated from the source model, so
# they are never worth versioning - a single turntable is 36 PNGs.
/out/
out/

# Pipeline state. work/<hash>/ holds per-model artefacts, runs/<id>/ holds
# orchestrator state and reports. Both are regenerable and can be large.
/work/
/runs/

# Test meshes, regenerated by scripts/make_fixtures.py
/fixtures/

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
dist/
*.tsbuildinfo

# Secrets. Nothing in this repo should ever carry a real key: the skills are
# meant to be readable by anyone, and every credential arrives from env.
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp

# Store-private config and keys. config.example.json is the committed template.
/store/config.json
/store/.env
/store/reference/
/store/etsy_token*.json
/store/social/
/store/products/
/store/integrations.json
/store/integrations.etsy-login.log
/intake/
test-runs/

# Marketing material: the LinkedIn film and its music, fonts and shots (170 MB). Not part of the product.
/marketing/
